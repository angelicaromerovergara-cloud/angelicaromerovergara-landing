---
import { SITE } from "../data/site.js";
---
<section id="agenda" aria-labelledby="agenda-heading" style="background:#E3D6C5;padding:var(--pad-y) var(--pad-x);display:grid;grid-template-columns:var(--cols-cta);gap:32px 48px;align-items:center">
  <div style="display:flex;flex-direction:column;gap:12px">
    <h2 id="agenda-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(26px,4vw,34px);line-height:1.1;font-weight:600;margin:0;text-wrap:pretty">¿Tienes un problema de estrategia o de ejecución?</h2>
    <p style="font-size:16.5px;line-height:1.65;margin:0;max-width:560px;color:#5D5545">Agenda una reunión de diagnóstico inicial: 25 minutos, sin costo y sin compromiso. Salimos con esa pregunta respondida.</p>
  </div>
  <div style="display:flex;flex-direction:column;gap:10px;align-items:flex-start">
    <a href={SITE.calLink} target="_blank" rel="noopener" class="btn-primary" style="background:#C15B42;color:#FFF4F0;font-size:16px;font-weight:500;padding:17px 32px;min-height:52px;display:inline-flex;align-items:center">{SITE.ctaLabel}</a>
  </div>
</section>
