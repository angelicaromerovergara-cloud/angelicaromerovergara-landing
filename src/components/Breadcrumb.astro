---
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav aria-label="Ruta de navegación">
  <ol style="display:flex;flex-wrap:wrap;align-items:center;gap:6px;list-style:none;margin:0;padding:0;font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:#A9B2BB">
    {items.map((item, i) => (
      <li style="display:flex;align-items:center;gap:6px">
        {i > 0 && <span aria-hidden="true" style="color:#5A6570">/</span>}
        {item.href ? (
          <a href={item.href} style="color:#A9B2BB;text-decoration:underline;text-underline-offset:3px">{item.name}</a>
        ) : (
          <span aria-current="page" style="color:#E3D6C5">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
