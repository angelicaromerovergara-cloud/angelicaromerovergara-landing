<section id="metodo" aria-labelledby="metodo-heading" style="background:#FFFFFF;padding:var(--pad-y) var(--pad-x)">
  <div style="max-width:1240px;margin:0 auto;display:grid;grid-template-columns:var(--cols-split);gap:var(--gap-lg);align-items:start">
    <div style="display:flex;flex-direction:column;gap:24px">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:#C15B42">Cómo trabajo</span>
      <h2 id="metodo-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(28px,4.6vw,44px);line-height:1.1;font-weight:600;letter-spacing:-.015em;margin:0;text-wrap:pretty">Cuatro pasos, siempre los mismos</h2>
      <img src="/assets/3-mt7fi9jv-zuth.png" alt="Angelica Romero Vergara trabajando con un equipo directivo" style="width:100%;height:clamp(220px,38vw,300px);object-fit:cover;object-position:50% 25%;display:block;background:#EDE8DC" />
    </div>
    <div style="display:flex;flex-direction:column">
      <div style="display:flex;gap:24px;padding:24px 0;border-top:1px solid #DCD5C7;border-bottom:1px solid #DCD5C7">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:500;line-height:1.4;color:#C15B42;width:34px;flex:none">01</span>
        <span style="display:flex;flex-direction:column;gap:8px;min-width:0">
          <span style="font-size:22px;font-weight:600;line-height:1.3">Diagnóstico inicial</span>
          <span style="font-size:14px;line-height:1.65;color:#5A6570">Entiendo tu situación real, no la que parece.</span>
        </span>
      </div>
      <div style="display:flex;gap:24px;padding:24px 0;border-bottom:1px solid #DCD5C7">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:500;line-height:1.4;color:#C15B42;width:34px;flex:none">02</span>
        <span style="display:flex;flex-direction:column;gap:8px;min-width:0">
          <span style="font-size:22px;font-weight:600;line-height:1.3">Mapa estratégico</span>
          <span style="font-size:14px;line-height:1.65;color:#5A6570">Identificamos prioridades, cuellos de botella y oportunidades concretas.</span>
        </span>
      </div>
      <div style="display:flex;gap:24px;padding:24px 0;border-bottom:1px solid #DCD5C7">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:500;line-height:1.4;color:#C15B42;width:34px;flex:none">03</span>
        <span style="display:flex;flex-direction:column;gap:8px;min-width:0">
          <span style="font-size:22px;font-weight:600;line-height:1.3">Plan de acción</span>
          <span style="font-size:14px;line-height:1.65;color:#5A6570">Con métricas, responsables y plazos reales.</span>
        </span>
      </div>
      <div style="display:flex;gap:24px;padding:24px 0;border-bottom:1px solid #DCD5C7">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:500;line-height:1.4;color:#C15B42;width:34px;flex:none">04</span>
        <span style="display:flex;flex-direction:column;gap:8px;min-width:0">
          <span style="font-size:22px;font-weight:600;line-height:1.3">Acompañamiento</span>
          <span style="font-size:14px;line-height:1.65;color:#5A6570">Implementación con seguimiento, no solo un informe que queda en un cajón.</span>
        </span>
      </div>
      <div style="background:#F0EDE4;border-left:3px solid #2E3A46;padding:20px 24px;margin-top:24px;display:flex;flex-direction:column;gap:4px">
        <span style="font-size:15px;font-weight:600">La pregunta que resolvemos primero</span>
        <span style="font-size:14px;line-height:1.65;color:#3F4A56">¿Tu empresa tiene un problema de estrategia o uno de ejecución? Son cosas distintas y se arreglan distinto.</span>
      </div>
    </div>
  </div>
</section>
