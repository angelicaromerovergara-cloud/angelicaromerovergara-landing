---
import { SITE, SERVICIOS, SOBRE_MI_URL, PRIVACIDAD_URL } from "../data/site.js";
---
<footer style="background:#2E3A46;padding:40px var(--pad-x) 28px;display:flex;flex-direction:column;gap:24px">
  <nav aria-label="Servicios" style="display:flex;flex-wrap:wrap;gap:12px 28px">
    <a href={SERVICIOS.diagnostico.url} class="footer-link" style="font-size:13.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">{SERVICIOS.diagnostico.nombre}</a>
    <a href={SERVICIOS.canvas.url} class="footer-link" style="font-size:13.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">{SERVICIOS.canvas.nombre}</a>
    <a href={SERVICIOS.taller.url} class="footer-link" style="font-size:13.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">{SERVICIOS.taller.nombre}</a>
    <a href={SERVICIOS.rendiciones.url} class="footer-link" style="font-size:13.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">{SERVICIOS.rendiciones.nombre}</a>
    <a href={SOBRE_MI_URL} class="footer-link" style="font-size:13.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">Sobre mí</a>
  </nav>
  <div style="display:flex;align-items:center;justify-content:space-between;gap:16px 24px;flex-wrap:wrap;border-top:1px solid #3E4B58;padding-top:20px">
    <span style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#8F99A3">© 2026 {SITE.nombre} · Valdivia, Región de Los Ríos</span>
    <a href={SITE.domain} class="footer-domain" style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#F0EDE4;min-height:44px;display:inline-flex;align-items:center;border-bottom:1px solid #C15B42;padding-bottom:3px">www.angelicaromero.cl</a>
    <span style="font-size:13.5px;line-height:1.5;color:#8F99A3">Ingeniera Comercial · <a href={`mailto:${SITE.correo}`} class="footer-link" style="color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">{SITE.correo}</a> · <a href={SITE.linkedin} target="_blank" rel="noopener" class="footer-link" style="color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">LinkedIn</a> · <a href={PRIVACIDAD_URL} class="footer-link" style="color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">Política de privacidad</a></span>
  </div>
</footer>
