---
import { SITE } from "../data/site.js";
---
<footer style="background:#2E3A46;padding:28px var(--pad-x);display:flex;align-items:center;justify-content:space-between;gap:16px 24px;flex-wrap:wrap">
  <span style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#8F99A3">© 2026 {SITE.nombre} · Valdivia, Región de Los Ríos</span>
  <a href={SITE.domain} class="footer-domain" style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#F0EDE4;min-height:44px;display:inline-flex;align-items:center;border-bottom:1px solid #C15B42;padding-bottom:3px">www.angelicaromero.cl</a>
  <span style="font-size:13.5px;line-height:1.5;color:#8F99A3">Ingeniera Comercial · <a href={`mailto:${SITE.correo}`} class="footer-link" style="color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">{SITE.correo}</a> · <a href={SITE.linkedin} target="_blank" rel="noopener" class="footer-link" style="color:#C8CED4;min-height:44px;display:inline-flex;align-items:center">LinkedIn</a></span>
</footer>
