---
// Hero de página interior (servicios y Sobre mí): igual paleta y tipografía
// que el hero de Home. A una columna por defecto; a dos columnas con foto
// (mismo tratamiento que el hero de Home: object-fit contain, sin recorte
// circular ni marco duro) cuando se pasa la prop `image`.
import { SITE } from "../data/site.js";
import Breadcrumb from "./Breadcrumb.astro";

interface Props {
  breadcrumbItems: { name: string; href?: string }[];
  eyebrow?: string;
  title: string;
  showCta?: boolean;
  ctaSubtext?: string;
  image?: { src: string; alt: string };
}
const {
  breadcrumbItems,
  eyebrow,
  title,
  showCta = true,
  ctaSubtext = "25 min · sin costo · sin compromiso",
  image,
} = Astro.props;
---
<section class="hero" style="position:relative;overflow:hidden;padding:var(--pad-y) var(--pad-x)">
  <div class={image ? "hero-grid" : undefined} style={image ? "position:relative;max-width:1240px;margin:0 auto" : "position:relative;max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:20px"}>
    <div style={image ? "grid-area:heading;display:flex;flex-direction:column;gap:20px" : "display:contents"}>
      <Breadcrumb items={breadcrumbItems} />
      {eyebrow && (
        <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:#C15B42">{eyebrow}</span>
      )}
      <h1 style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(30px,5.4vw,46px);line-height:1.12;font-weight:600;letter-spacing:-.02em;margin:0;color:#F0EDE4;text-wrap:pretty">{title}</h1>
    </div>
    {image && (
      <div class="hero-photo" style="grid-area:photo;position:relative;display:flex;align-items:flex-end;justify-content:flex-end;height:var(--hero-img-h);border-top:3px solid #C15B42">
        <img src={image.src} alt={image.alt} style="width:auto;max-width:var(--hero-img-max);height:100%;object-fit:contain;object-position:50% 100%;display:block" />
      </div>
    )}
    <div style={image ? "grid-area:body;display:flex;flex-direction:column;gap:20px" : "display:contents"}>
      <div style="display:flex;flex-direction:column;gap:16px;font-size:17px;line-height:1.65;color:#C8CED4;max-width:640px">
        <slot />
      </div>
      {showCta && (
        <div style="display:flex;align-items:center;gap:24px;padding-top:8px;flex-wrap:wrap">
          <a href={SITE.calLink} target="_blank" rel="noopener" class="btn-primary" style="background:#C15B42;color:#FFF4F0;font-size:16px;font-weight:500;padding:16px 30px;min-height:52px;display:inline-flex;align-items:center">{SITE.ctaLabel}</a>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:12.5px;line-height:1.6;color:#A9B2BB">{ctaSubtext}</span>
        </div>
      )}
    </div>
  </div>
</section>
