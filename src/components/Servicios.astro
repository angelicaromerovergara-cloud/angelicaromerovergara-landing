---
import { SITE, SERVICIOS } from "../data/site.js";

const servicios = [
  {
    n: "01",
    url: SERVICIOS.diagnostico.url,
    nombre: SERVICIOS.diagnostico.nombre,
    linea: "Para gerentes y directivos de Pymes que necesitan claridad antes de tomar decisiones de crecimiento.",
    incluye: "Revisión del modelo de negocio actual, análisis de brechas comerciales y financieras, hoja de ruta priorizada con acciones concretas.",
    resultado: "Un mapa de decisiones claro en 2 sesiones, sin diagnósticos que duermen en un cajón.",
    quien: "Gerentes generales o directores de Pymes que sienten que el negocio crece sin orden.",
    tiempo: "2 sesiones de 90 min · 10–15 días",
    destacado: true,
  },
  {
    n: "02",
    url: SERVICIOS.canvas.url,
    nombre: "Consultoría Estratégica y Comercial Independiente (metodología CANVAS)",
    linea: "Asesoría independiente desde 2023, después de diez años al frente de Consultora Focus Valdivia. Proceso completo para quienes necesitan método, no solo consejo.",
    incluye: "Diseño o rediseño del modelo de negocio, estructura comercial, análisis financiero de gestión, acompañamiento en implementación.",
    resultado: "Un equipo que toma decisiones con datos, con una estrategia comercial que se puede ejecutar sin depender de la consultora.",
    quien: "Pymes con equipo directivo formado que quieren escalar con control, no a ciegas.",
    tiempo: "Proceso de 3 a 6 meses, según complejidad",
  },
  {
    n: "03",
    url: SERVICIOS.taller.url,
    nombre: SERVICIOS.taller.nombre,
    linea: "Para organizaciones cuyo equipo toma decisiones sin leer bien los números.",
    incluye: "Taller práctico de lectura e interpretación de estados financieros, indicadores clave de gestión, decisiones basadas en datos reales del negocio.",
    resultado: "Quienes deciden en la pyme entienden el lenguaje financiero y pueden proyectar el crecimiento del negocio.",
    quien: "Equipos de 3 a 10 personas que participan en las decisiones financieras de la pyme, tengan o no un cargo formal de dirección.",
    tiempo: "1 jornada de 6–8 h, o 3 sesiones de 2 h",
  },
  {
    n: "04",
    url: SERVICIOS.rendiciones.url,
    nombre: SERVICIOS.rendiciones.nombre,
    linea: "Reviso tu rendición antes de que llegue a Contraloría, para que no tengas que devolver un gasto ya ejecutado.",
    incluye: "Inducción normativa del proyecto, revisión previa al envío de cada rendición y acompañamiento durante todo el ciclo del programa.",
    resultado: "Menos observaciones de Contraloría, menos reproceso y menor riesgo de restituir fondos ya ejecutados.",
    quien: "Ejecutores privados de fondos públicos (fundaciones, ONG) y municipios que rinden ante Contraloría.",
    tiempo: "Revisión periódica por ciclo de rendición · valor definido en el diagnóstico",
  },
];
---
<section id="servicios" aria-labelledby="servicios-heading" style="background:#E3D6C5;padding:var(--pad-y) var(--pad-x)">
  <div style="max-width:1240px;margin:0 auto;display:flex;flex-direction:column;gap:40px">
    <div style="display:flex;flex-direction:column;gap:16px;max-width:720px">
      <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:#A94A34">Servicios</span>
      <h2 id="servicios-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(28px,4.6vw,44px);line-height:1.1;font-weight:600;letter-spacing:-.015em;margin:0;text-wrap:pretty">Cuatro servicios, una sola puerta de entrada</h2>
      <p style="font-size:17px;line-height:1.65;margin:0;color:#5D5545;text-wrap:pretty">Todo parte por una reunión de diagnóstico de 25 minutos, sin costo. Desde ahí definimos cuál de estos servicios corresponde — o si no corresponde ninguno, también te lo digo.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));gap:24px">
      {servicios.map((s) => (
        <div style={`background:${s.destacado ? "#2E3A46" : "#FFFFFF"};${s.destacado ? "border-top:3px solid #C15B42;" : "border:1px solid #DCD5C7;"}padding:clamp(22px,3.2vw,32px);display:flex;flex-direction:column;gap:20px`}>
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap">
            <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:#C15B42">Servicio {s.n}</span>
            {s.destacado && (
              <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#FFF4F0;background:#C15B42;border:1px solid #C15B42;padding:6px 9px;white-space:nowrap">Puerta de entrada</span>
            )}
          </div>
          <div style="display:flex;flex-direction:column;gap:12px">
            <h3 style={`font-family:'Source Serif 4',Georgia,serif;font-size:24px;line-height:1.2;font-weight:600;margin:0;text-wrap:pretty`}>
              <a href={s.url} style={`color:${s.destacado ? "#F0EDE4" : "#2E3A46"};text-decoration:none`}>{s.nombre}</a>
            </h3>
            <span style={`font-size:14px;line-height:1.65;color:${s.destacado ? "#C8CED4" : "#5A6570"}`}>{s.linea}</span>
          </div>
          <div style={`display:flex;flex-direction:column;gap:16px;border-top:1px solid ${s.destacado ? "#3E4B58" : "#DCD5C7"};padding-top:20px`}>
            <div style="display:grid;grid-template-columns:var(--cols-label);gap:6px 16px;align-items:start">
              <span style={`font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:${s.destacado ? "#A9B2BB" : "#7A8590"};padding-top:3px`}>Qué incluye</span>
              <span style={`font-size:14.5px;line-height:1.6;color:${s.destacado ? "#F0EDE4" : "#3F4A56"}`}>{s.incluye}</span>
            </div>
            <div style="display:grid;grid-template-columns:var(--cols-label);gap:6px 16px;align-items:start">
              <span style={`font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:${s.destacado ? "#A9B2BB" : "#7A8590"};padding-top:3px`}>Resultado</span>
              <span style={`font-size:14.5px;line-height:1.6;color:${s.destacado ? "#F0EDE4" : "#3F4A56"}`}>{s.resultado}</span>
            </div>
            <div style="display:grid;grid-template-columns:var(--cols-label);gap:6px 16px;align-items:start">
              <span style={`font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:${s.destacado ? "#A9B2BB" : "#7A8590"};padding-top:3px`}>Para quién</span>
              <span style={`font-size:14.5px;line-height:1.6;color:${s.destacado ? "#F0EDE4" : "#3F4A56"}`}>{s.quien}</span>
            </div>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:auto;padding-top:8px">
            <span style={`font-family:'IBM Plex Mono',monospace;font-size:12.5px;line-height:1.5;color:${s.destacado ? "#A9B2BB" : "#7A8590"}`}>{s.tiempo}</span>
            {s.destacado ? (
              <a href={SITE.calLink} target="_blank" rel="noopener" class="btn-outline" style="border:1px solid #F0EDE4;color:#F0EDE4;font-size:13.5px;font-weight:500;padding:11px 18px;min-height:44px;display:inline-flex;align-items:center">Agenda una reunión</a>
            ) : (
              <a href={s.url} style="color:#C15B42;font-size:13.5px;font-weight:500">→ Ver servicio</a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
