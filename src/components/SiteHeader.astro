---
import { SITE, SOBRE_MI_URL } from "../data/site.js";
---
<header style="position:sticky;top:0;z-index:20;background:#2E3A46;padding:16px var(--pad-x);display:flex;align-items:center;justify-content:space-between;gap:16px 32px;flex-wrap:wrap">
  <a href="/" style="display:flex;align-items:center;gap:14px;min-height:44px;text-decoration:none">
    <span style="width:40px;height:40px;flex:none;border:1.2px solid #C15B42;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px">
      <span style="font-family:'Source Serif 4',Georgia,serif;font-weight:600;font-size:12px;letter-spacing:.1em;text-indent:.1em;color:#F0EDE4;line-height:1">ARV</span>
      <span style="width:12px;height:1.5px;background:#C15B42"></span>
    </span>
    <span style="font-family:'Source Serif 4',Georgia,serif;font-size:16px;font-weight:600;color:#F0EDE4">{SITE.nombre}</span>
  </a>
  <nav aria-label="Principal" style="display:flex;align-items:center;gap:16px 28px;flex-wrap:wrap">
    <a href="/#trayectoria" class="nav-link" style="font-size:14.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center;padding-bottom:2px;border-bottom:1px solid transparent">Trayectoria</a>
    <a href="/#metodo" class="nav-link" style="font-size:14.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center;padding-bottom:2px;border-bottom:1px solid transparent">Cómo trabajo</a>
    <a href="/#servicios" class="nav-link" style="font-size:14.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center;padding-bottom:2px;border-bottom:1px solid transparent">Servicios</a>
    <a href={SOBRE_MI_URL} class="nav-link" style="font-size:14.5px;color:#C8CED4;min-height:44px;display:inline-flex;align-items:center;padding-bottom:2px;border-bottom:1px solid transparent">Sobre mí</a>
    <a href={SITE.calLink} target="_blank" rel="noopener" class="btn-primary" style="background:#C15B42;color:#FFF4F0;font-size:14px;font-weight:500;padding:12px 20px;min-height:44px;display:inline-flex;align-items:center">{SITE.ctaLabel}</a>
  </nav>
</header>
