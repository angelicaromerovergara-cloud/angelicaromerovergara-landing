---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import PageHero from "../components/PageHero.astro";
import CierreCTA from "../components/CierreCTA.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE, SERVICIOS, SOBRE_MI_URL } from "../data/site.js";
import { breadcrumbSchema } from "../lib/schema.js";

const title = "Sobre Angelica Romero Vergara | +20 años en Banca y Consultoría";
const description = "Ingeniera Comercial con +20 años en Banco de Chile, Serplac Los Ríos y consultoría a pymes. Conoce la trayectoria detrás de cada servicio.";
const path = SOBRE_MI_URL;

const breadcrumbItems = [
  { name: "Inicio", href: "/" },
  { name: "Sobre mí" },
];

const jsonLd = breadcrumbSchema(
  breadcrumbItems.map((item) => ({
    name: item.name,
    url: item.href ? new URL(item.href, SITE.domain).toString() : new URL(path, SITE.domain).toString(),
  }))
);
---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <SiteHeader />
  <main>
    <PageHero breadcrumbItems={breadcrumbItems} title="20+ años en banca, sector público y consultoría" showCta={false} />

    <section aria-labelledby="trayectoria-heading" style="background:#FFFFFF;padding:var(--pad-y) var(--pad-x)">
      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:32px">
        <h2 id="trayectoria-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(26px,4vw,36px);line-height:1.15;font-weight:600;letter-spacing:-.015em;margin:0;text-wrap:pretty">Trayectoria</h2>
        <div style="display:flex;flex-direction:column;gap:28px">
          <div style="display:flex;flex-direction:column;gap:8px">
            <h3 style="font-size:19px;line-height:1.3;font-weight:600;margin:0;color:#2E3A46">Banca — riesgo (Banco de Chile, 2005–2011)</h3>
            <p style="font-size:15px;line-height:1.65;margin:0;color:#5A6570">Cinco años como ejecutiva de cuentas en banca masiva, preferencial y empresas. Ahí aprendí a evaluar un negocio antes de financiarlo: ventas, caja, endeudamiento y capacidad de pago. Ese criterio es la base de cada diagnóstico que hago hoy.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <h3 style="font-size:19px;line-height:1.3;font-weight:600;margin:0;color:#2E3A46">Fondos públicos — rigor (Serplac Los Ríos, 2014–2022 · Seremi de Desarrollo Social, 2026)</h3>
            <p style="font-size:15px;line-height:1.65;margin:0;color:#5A6570">Ocho años en Serplac Los Ríos preparando y ejecutando presupuesto regional, gestionando compras públicas y revisando rendiciones financieras de programas MIDESO. En 2026 volví a esa misma unidad —ahora la Seremi de Desarrollo Social— para coordinar la Unidad de Administración completa: presupuesto interno, RRHH y compras públicas, ocho meses sin observaciones.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <h3 style="font-size:19px;line-height:1.3;font-weight:600;margin:0;color:#2E3A46">Consultoría — ejecución (Consultora Focus Valdivia, 2013–2023 · independiente desde 2023)</h3>
            <p style="font-size:15px;line-height:1.65;margin:0;color:#5A6570">Diez años al frente de Consultora Focus Valdivia, asesorando pymes en modelamiento de negocio con metodología CANVAS, análisis financiero y acceso a financiamiento externo. La asesoría continúa hoy de forma independiente, sin interrupción.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <h3 style="font-size:19px;line-height:1.3;font-weight:600;margin:0;color:#2E3A46">Territorio — terreno (FUDEA UFRO / programa GORE Los Ríos, 2023–2026)</h3>
            <p style="font-size:15px;line-height:1.65;margin:0;color:#5A6570">Tres años coordinando un programa financiado por el GORE Los Ríos, con MM $1.900 en presupuesto público y rendiciones aprobadas, trabajando directamente con ferias costumbristas de la región.</p>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="formacion-heading" style="background:#F0EDE4;padding:var(--pad-y) var(--pad-x)">
      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:16px">
        <h2 id="formacion-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(26px,4vw,36px);line-height:1.15;font-weight:600;letter-spacing:-.015em;margin:0;text-wrap:pretty">Formación</h2>
        <p style="font-size:17px;line-height:1.65;margin:0;color:#5A6570">Ingeniera Comercial, Universidad Gabriela Mistral. Cursos de capacitación en Contraloría General de la República (remuneraciones del sector público, estatuto administrativo) y en Dirección ChileCompra (bases de licitación, trato directo).</p>
      </div>
    </section>

    <section aria-labelledby="traduce-heading" style="background:#FFFFFF;padding:var(--pad-y) var(--pad-x)">
      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:20px">
        <h2 id="traduce-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(26px,4vw,36px);line-height:1.15;font-weight:600;letter-spacing:-.015em;margin:0;text-wrap:pretty">Cómo esto se traduce en cada servicio</h2>
        <p style="font-size:17px;line-height:1.65;margin:0;color:#5A6570">
          El frente de <strong>fondos públicos</strong> —ocho años en Serplac, el programa GORE Los Ríos— es la base directa de <strong><a href={SERVICIOS.rendiciones.url} style="color:#C15B42;text-decoration:underline">Revisión de Rendiciones de Cuentas</a></strong>. El frente de <strong>consultoría</strong> —diez años en Focus Valdivia— sostiene <strong><a href={SERVICIOS.canvas.url} style="color:#C15B42;text-decoration:underline">Consultoría Estratégica y Comercial (CANVAS)</a></strong>. Y el frente de <strong>banca</strong> —cinco años evaluando riesgo en Banco de Chile— es el criterio detrás de cada <a href={SERVICIOS.diagnostico.url} style="color:#C15B42;text-decoration:underline">diagnóstico</a> y de cada <a href={SERVICIOS.taller.url} style="color:#C15B42;text-decoration:underline">Taller Financiero</a>.
        </p>
        <p style="font-size:17px;line-height:1.65;margin:0;color:#5A6570">Quien trabaja conmigo sabe que el dinero se cuida, los procesos se documentan y los planes se ejecutan. Eso no es una promesa: es la misma trayectoria, aplicada a tu empresa.</p>
      </div>
    </section>

    <CierreCTA
      title="¿Conversamos sobre tu caso?"
      description="Una reunión de diagnóstico de 25 minutos, sin costo y sin compromiso."
    />
  </main>
  <SiteFooter />
</BaseLayout>
