---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import PageHero from "../../components/PageHero.astro";
import EnlaceAgenda from "../../components/EnlaceAgenda.astro";
import RelatedService from "../../components/RelatedService.astro";
import CierreCTA from "../../components/CierreCTA.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { SITE, SERVICIOS } from "../../data/site.js";
import { breadcrumbSchema } from "../../lib/schema.js";

const title = 'Taller "Finanzas para tomar decisiones" | ARV';
const description = 'Taller "Finanzas para tomar decisiones": caja, margen y endeudamiento en un lenguaje común para quienes deciden en tu pyme. Jornada única o 3 sesiones.';
const path = SERVICIOS.taller.url;

const breadcrumbItems = [
  { name: "Inicio", href: "/" },
  { name: "Servicios", href: "/#servicios" },
  { name: SERVICIOS.taller.nombre },
];

const jsonLd = breadcrumbSchema(
  breadcrumbItems.map((item) => ({
    name: item.name,
    url: item.href ? new URL(item.href, SITE.domain).toString() : new URL(path, SITE.domain).toString(),
  }))
);
---
<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <SiteHeader />
  <main>
    <PageHero breadcrumbItems={breadcrumbItems} title="¿En tu pyme cada uno interpreta los números a su manera?">
      <p>Cuando el dueño, quien administra y quien vende leen la caja, el margen o el endeudamiento cada uno a su manera, las reuniones se alargan sin llegar a acuerdo. Un taller financiero para quienes deciden en tu pyme resuelve eso en una jornada o en tres sesiones, no en un curso genérico de meses.</p>
    </PageHero>

    <section aria-labelledby="que-es-heading" style="background:#FFFFFF;padding:var(--pad-y) var(--pad-x)">
      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:16px">
        <h2 id="que-es-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(26px,4vw,36px);line-height:1.15;font-weight:600;letter-spacing:-.015em;margin:0;text-wrap:pretty">Taller "Finanzas para tomar decisiones"</h2>
        <p style="font-size:17px;line-height:1.65;margin:0;color:#5A6570">Un espacio de trabajo directo con tu equipo de gestión, centrado en los conceptos financieros que se usan a diario para decidir: caja, margen, capacidad de pago, endeudamiento y riesgo.</p>
      </div>
    </section>

    <section aria-labelledby="formato-heading" style="background:#F0EDE4;padding:var(--pad-y) var(--pad-x)">
      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:24px">
        <h2 id="formato-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(26px,4vw,36px);line-height:1.15;font-weight:600;letter-spacing:-.015em;margin:0;text-wrap:pretty">Formato</h2>
        <div style="display:flex;flex-direction:column;gap:28px">
          <div style="display:flex;flex-direction:column;gap:8px">
            <h3 style="font-size:19px;line-height:1.3;font-weight:600;margin:0;color:#2E3A46">Jornada intensiva o 3 sesiones</h3>
            <p style="font-size:15px;line-height:1.65;margin:0;color:#5A6570">Se define según la disponibilidad del equipo, no al revés: una jornada completa o tres sesiones espaciadas, con el mismo contenido.</p>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px">
            <h3 style="font-size:19px;line-height:1.3;font-weight:600;margin:0;color:#2E3A46">Equipos de 3 a 10 personas</h3>
            <p style="font-size:15px;line-height:1.65;margin:0;color:#5A6570">Pensado para quienes participan en las decisiones financieras de la pyme, tengan o no un cargo formal de dirección — no para capacitaciones masivas.</p>
          </div>
        </div>
        <EnlaceAgenda />
      </div>
    </section>

    <section aria-labelledby="por-que-heading" style="background:#FFFFFF;padding:var(--pad-y) var(--pad-x)">
      <div style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;gap:16px">
        <h2 id="por-que-heading" style="font-family:'Source Serif 4',Georgia,serif;font-size:clamp(26px,4vw,36px);line-height:1.15;font-weight:600;letter-spacing:-.015em;margin:0;text-wrap:pretty">Por qué este taller y no una capacitación genérica</h2>
        <p style="font-size:17px;line-height:1.65;margin:0;color:#5A6570">Cinco años como ejecutiva de cuentas en Banco de Chile, evaluando riesgo en banca masiva, preferencial y empresas, son la base de este contenido: no es teoría de manual, es el mismo criterio con que un banco decide financiar o no un negocio. A diferencia de una capacitación OTEC o SENCE estándar, este taller se ajusta a los números reales de tu empresa, no a un caso genérico.</p>
      </div>
    </section>

    <section aria-label="Servicio relacionado" style="background:#F0EDE4;padding:var(--pad-y) var(--pad-x)">
      <div style="max-width:760px;margin:0 auto">
        <RelatedService>
          Si además del lenguaje común el equipo necesita reordenar el modelo de negocio completo, el siguiente paso natural es <a href={SERVICIOS.canvas.url} style="color:#C15B42;text-decoration:underline">Evolución Estratégica Del Negocio (metodología CANVAS)</a>.
        </RelatedService>
      </div>
    </section>

    <CierreCTA
      title="¿Quienes deciden en tu pyme necesitan hablar el mismo idioma financiero?"
      description="Una reunión de diagnóstico de 25 minutos, sin costo, define el formato que mejor se ajusta a tu equipo."
    />
  </main>
  <SiteFooter />
</BaseLayout>
